# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db?schema=public

# JWT Authentication Secret Key (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional SMTP Email Configuration (for verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM=your_email@gmail.com
