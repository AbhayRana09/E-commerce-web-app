# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce_db?schema=public"

# JWT Authentication Secret Key (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Configuration (For Email Verification & Password Resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM="your-email@gmail.com"


